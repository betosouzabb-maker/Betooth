modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "cd backend && node dist/server.js"]
build = ["sh", "-c", "cd backend && npm ci && npm run build && npx prisma migrate deploy"]

[[ports]]
localPort = 3333
externalPort = 80

[env]
NODE_ENV = "production"
PORT = "3333"
