PORT=3333
NODE_ENV=development
API_PREFIX=/api/v1
APP_NAME=Betooth Backend
APP_URL=http://localhost:3333
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Database (Railway preenche automaticamente via ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betooth?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/betooth?schema=public

# Redis (Railway preenche automaticamente via ${{Redis.REDIS_URL}})
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# JWT — gere valores aleatórios fortes para produção
# Exemplo: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# AWS S3 (ou Cloudflare R2)
S3_REGION=sa-east-1
S3_BUCKET=betooth-prod
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# BullMQ / Queue
QUEUE_PREFIX=betooth

# Admin
ADMIN_MASTER_PASSWORD=change-me-admin-password

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=
MP_PLAN_PRICE_CENTS=999
MP_PLAN_LABEL=Betooth VIP Mensal

# Download Quota
FREE_MONTHLY_DOWNLOAD_LIMIT=5

# Subscription VIP cache TTL
VIP_CACHE_TTL_SECONDS=300
