{
  "name": "betooth-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend base do app Betooth com Express, TypeScript, Prisma e Redis.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "test": "node -e \"console.log('No tests configured yet')\"",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@prisma/client": "^6.8.2",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.52.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "music-metadata": "^7.14.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.19",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
